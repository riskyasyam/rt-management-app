							"name": "Success - Daftar Warga",
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"body": "{\n    \"status\": \"success\",\n    \"data\": [\n        {\n            \"id\": 1,\n            \"nama_lengkap\": \"Budi Santoso\",\n            \"foto_ktp\": \"uploads/ktp/abc123.jpg\",\n            \"status_warga\": \"tetap\",\n            \"nomor_telepon\": \"081234567890\",\n            \"status_pernikahan\": \"menikah\"\n        }\n    ]\n}"
