		{
			"name": "3. Keuangan",
			"description": "Endpoint pengelolaan keuangan RT: pembayaran iuran, pencatatan pengeluaran, histori pembayaran, dan laporan keuangan (Kriteria 3).",
			"item": [
				{
					"name": "POST - Bayar Iuran Warga",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
